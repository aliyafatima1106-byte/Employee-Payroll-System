"""
Employee Payroll System
Python 3 | OOP, inheritance, validation, and file handling

Rules from the project brief:
- Overtime pay = Rs. 200 per hour
- Manager bonus = 10% of basic salary
- PF = 12% of basic salary
- Tax = 10% of gross salary only when gross salary > Rs. 50,000
- Gross = basic salary + overtime pay + bonus
- Net salary = gross - PF - tax
"""

from dataclasses import dataclass


OVERTIME_RATE = 200
PF_RATE = 0.12
TAX_RATE = 0.10
TAX_THRESHOLD = 50000
MANAGER_BONUS_RATE = 0.10
PAYROLL_FILE = "payroll.txt"


@dataclass
class Employee:
    name: str
    basic_salary: float
    overtime_hours: float

    def __post_init__(self):
        self.name = self.name.strip()
        if not self.name:
            raise ValueError("Employee name cannot be empty.")
        if self.basic_salary <= 0:
            raise ValueError("Invalid basic salary. Enter a positive number.")
        if self.overtime_hours < 0:
            raise ValueError("Invalid overtime hours. Enter a non-negative number.")

    def calculate_overtime(self):
        return self.overtime_hours * OVERTIME_RATE

    def calculate_bonus(self):
        return 0.0

    def calculate_gross(self):
        return self.basic_salary + self.calculate_overtime() + self.calculate_bonus()

    def calculate_pf(self):
        return self.basic_salary * PF_RATE

    def calculate_tax(self):
        gross = self.calculate_gross()
        return gross * TAX_RATE if gross > TAX_THRESHOLD else 0.0

    def calculate_net(self):
        return self.calculate_gross() - self.calculate_pf() - self.calculate_tax()

    def payslip(self):
        gross = self.calculate_gross()
        bonus = self.calculate_bonus()
        pf = self.calculate_pf()
        tax = self.calculate_tax()
        net = self.calculate_net()

        lines = [
            "=" * 48,
            "                 EMPLOYEE PAYSLIP",
            "=" * 48,
            f"Employee Name : {self.name}",
            f"Employee Type : {self.__class__.__name__}",
            f"Basic Salary  : Rs. {self.basic_salary:.2f}",
            f"Overtime Hours: {self.overtime_hours:g}",
            f"Overtime Pay  : Rs. {self.calculate_overtime():.2f}",
            f"Bonus         : Rs. {bonus:.2f}",
            "-" * 48,
            f"Gross Salary  : Rs. {gross:.2f}",
            f"PF Deduction  : Rs. {pf:.2f}",
            f"Tax Deduction : Rs. {tax:.2f}",
            f"Net Salary    : Rs. {net:.2f}",
            "=" * 48,
            "",
        ]
        return "\n".join(lines)


class Manager(Employee):
    """Manager gets a bonus equal to 10% of basic salary."""

    def calculate_bonus(self):
        return self.basic_salary * MANAGER_BONUS_RATE


def save_payslip(employee, filename=PAYROLL_FILE):
    """Append one employee's payslip to a text file."""
    with open(filename, "a", encoding="utf-8") as file:
        file.write(employee.payslip())


def read_number(prompt, *, allow_zero=False):
    """Read a numeric value and reject non-numeric or invalid values."""
    while True:
        raw_value = input(prompt).strip()
        try:
            value = float(raw_value)
        except ValueError:
            if allow_zero:
                print("Invalid overtime hours. Enter a non-negative number.")
            else:
                print("Invalid basic salary. Enter a positive number.")
            continue

        if allow_zero:
            if value < 0:
                print("Invalid overtime hours. Enter a non-negative number.")
                continue
        elif value <= 0:
            print("Invalid basic salary. Enter a positive number.")
            continue

        return value


def create_employee():
    """Collect and validate details, then return an Employee or Manager."""
    while True:
        name = input("Employee/manager name: ").strip()
        if name:
            break
        print("Name cannot be empty. Please try again.")

    while True:
        role = input("Role (E = Employee, M = Manager): ").strip().lower()
        if role in ("e", "employee", "m", "manager"):
            break
        print("Please enter E for Employee or M for Manager.")

    basic_salary = read_number("Basic salary (Rs.): ")
    overtime_hours = read_number("Overtime hours: ", allow_zero=True)

    employee_class = Manager if role in ("m", "manager") else Employee
    return employee_class(name, basic_salary, overtime_hours)


def run_self_tests():
    """Check all four scenarios from the assignment sheet."""
    tests = [
        ("Test 1: Normal employee", Employee("Aman", 30000, 10),
         {"gross": 32000, "pf": 3600, "tax": 0, "net": 28400}),
        ("Test 2: Minimum/boundary employee", Employee("Neha", 10000, 0),
         {"gross": 10000, "pf": 1200, "tax": 0, "net": 8800}),
        ("Test 4: Manager", Manager("Riya", 60000, 5),
         {"gross": 67000, "pf": 7200, "tax": 6700, "net": 53100}),
    ]

    for label, person, expected in tests:
        actual = {
            "gross": person.calculate_gross(),
            "pf": person.calculate_pf(),
            "tax": person.calculate_tax(),
            "net": person.calculate_net(),
        }
        assert actual == expected, f"{label} failed: {actual} != {expected}"
        print(f"PASS - {label}")

    # Invalid input cases from Test 3
    try:
        Employee("InvalidSalary", -5000, 0)
    except ValueError as error:
        assert str(error) == "Invalid basic salary. Enter a positive number."
        print("PASS - Test 3(a): Negative salary rejected")
    else:
        raise AssertionError("Negative salary should have been rejected.")

    try:
        Employee("InvalidOvertime", 10000, -1)
    except ValueError as error:
        assert str(error) == "Invalid overtime hours. Enter a non-negative number."
        print("PASS - Invalid negative overtime rejected")

    # The interactive reader also rejects text such as 'abc' and asks again.
    # That behavior is covered manually by entering abc at the overtime prompt.


def main():
    print("\nEMPLOYEE PAYROLL SYSTEM")
    print("-----------------------")
    print("Enter employee details below. Payslips are saved to payroll.txt.\n")

    employees = []
    while True:
        try:
            employee = create_employee()
            employees.append(employee)
            save_payslip(employee)
            print("\n" + employee.payslip())
            print(f"Payslip appended to {PAYROLL_FILE}.")
        except ValueError as error:
            print(f"Could not create employee: {error}")

        another = input("\nAdd another employee? (y/n): ").strip().lower()
        if another not in ("y", "yes"):
            break

    if employees:
        print(f"\nCompleted. {len(employees)} payslip(s) saved to {PAYROLL_FILE}.")
    else:
        print("\nNo employee records were added.")


if __name__ == "__main__":
    main()
